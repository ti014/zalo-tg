TG_TOKEN=replace-with-telegram-bot-token
TG_GROUP_ID=-1001234567890
TG_OWNER_IDS=123456789
TG_DOWNLOAD_MAX_MB=20
TG_UPLOAD_PART_MB=45
TG_UPLOAD_TIMEOUT_SEC=600
MEDIA_MAX_OBJECT_MB=200
MEDIA_SPOOL_MAX_MB=5120
DELIVERY_SENT_RETENTION_DAYS=90
DATA_MIN_FREE_MB=512
# Advanced only: current Compose does not share local Bot API file storage.
# See docs/operations.md before enabling TG_API_ROOT.
# TG_API_ROOT=http://telegram-bot-api:8081

BRIDGE_DATA_VOLUME=zalo-tg-data
BRIDGE_IMAGE=zalo-tg-bridge:local
# Set this to the deployed Git commit when building a release image.
BUILD_REVISION=local-dirty
BUILD_VERSION=1.0.0
DATA_DIR=/app/data
DATABASE_PATH=/app/data/bridge.db
HEALTH_DIR=/tmp/health
ZALO_CREDENTIALS_PATH=/app/data/credentials.json
ZALO_SKIP_MUTED_GROUPS=false
ZALO_SKIP_STRANGER_MESSAGES=false
UPDATE_CHECK_ENABLED=false
ALLOW_SECRET_BACKUP=false
